rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Configurações de API: Qualquer usuário autenticado pode ler a URL do túnel.
    match /settings/api_config {
      allow read: if request.auth != null;
    }
    
    // Regra: Apenas usuários autenticados podem ler/escrever SEUS PRÓPRIOS dados.
    match /projects/{document} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    match /snippets/{document} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    match /links/{document} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /backups/{document} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
